# Copiez ce fichier en « .env » et personnalisez les valeurs.

# Clé de signature des jetons de session (mettez une longue chaîne aléatoire)
JWT_SECRET=changez-moi-pour-une-chaine-aleatoire-de-64-caracteres-minimum

# Compte super-administrateur mGlobal (vue globale + administration)
# Identifiants par défaut si non renseignés : mGlobal / mGlobal2026
SUPERADMIN_USER=mGlobal
SUPERADMIN_PASSWORD=mGlobal2026

# Durée de validité d'une session
TOKEN_TTL=12h

# Clé de liaison du poste pont bascule (optionnel : sinon générée au 1er démarrage,
# visible dans les logs et dans Administration → Liaison du poste).
# SITE_KEY=

# Port d'écoute interne
PORT=4000
